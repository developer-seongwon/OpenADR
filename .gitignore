# compile foolder
# 그래들 산출물(build/, .gradle/)은 avob-client/.gitignore, avob-server/.gitignore 가 뺀다.
# target 은 루트(빌드한 jar 를 모으는 곳, 루트 build.gradle)와 메이븐으로 남은 OpenfireOadrPlugin 의 산출물이다
target/
.gradle/
# 루트 composite 빌드의 산출물(문제 리포트 등)
/build/

*/package-lock.json
# 맥 Finder 가 만드는 파일. git add -A 로 같이 올라가지 않게
.DS_Store

# 테스트 인증서. cert/generate_test_cert.sh 가 PC 마다 만들고 개인키가 들어 있어서 스크립트만 올린다.
# 예전 규칙(cert*)은 경로 제한이 없어서 모듈의 src/test/resources/cert 에 새로 넣는 파일까지 가렸다
/cert/*
!/cert/generate_test_cert.sh
# 메이븐 때 frontend 빌드 결과를 복사해 두던 곳. 그래들은 jar 에 바로 넣는다(남아 있어도 jar 에서 빠진다)
avob-server/OpenADRServerVTN20b/src/main/resources/public/
avob-server/OpenADRServerVTN20b/frontend/build/
avob-server/OpenADRServerVTN20b/frontend/node_modules/
avob-server/OpenADRServerVTN20b/frontend/package-lock.json
