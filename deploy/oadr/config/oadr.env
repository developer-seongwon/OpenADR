# 서버마다 고치는 값. bin/run.sh 가 docker compose 에 넘긴다(--env-file).
# 배포할 때 이 파일은 덮어쓰지 않는다(서버에서 고친 값이 남아야 한다).
# 경로가 상대 경로면 docker-compose.yml 이 있는 디렉토리 기준이다.

# VTN 주소. VEN 이 붙는 이 서버의 이름이나 IP 만 넣는다(포트는 VTN_PORT). 쉼표로 여러 개 넣을 수 있다(vtn.example.com,10.0.0.5)
# auto 는 bin/run.sh 가 이 서버 IP 를 찾아서 넣는다(비워 둬도 auto). 이름과 같이 쓸 수 있다(auto,vtn.example.com)
# bin/run.sh 가 VTN 서버 인증서를 이 이름들로 KEYSTORE_DIR 에 만든다(vtn.oadr.com, localhost, 127.0.0.1 은 늘 들어간다).
# 값이 바뀌면(auto 면 서버 IP 가 바뀌면) 다음 start 때 인증서를 다시 만든다.
# VEN 에 넣을 VTN 주소는 https://<VTN_HOST>:<VTN_PORT>/testvtn/OpenADR2/Simple/2.0b(VTN 관리 화면 VTN 설정 > 설정값에서 복사한다)
VTN_HOST=auto

# 포트는 9970 대로 묶는다(9970 VTN, 9971 RabbitMQ 관리, 9972 Openfire 관리. AMQP, XMPP, PostgreSQL 은 서버 밖에 열지 않는다)
# VTN 포트. VEN 과 웹 UI 가 붙는다. 바꾸면 VEN 에 넣은 VTN 주소의 포트도 같이 바꾼다
VTN_PORT=9970

# VTN 서버 인증서(vtn.key, vtn.crt)와 CA 인증서(ca.crt)를 두는 곳. vtn20b 에 마운트한다
KEYSTORE_DIR=./keystore

# 관리 화면(RabbitMQ, Openfire)을 여는 주소와 포트. 127.0.0.1 이면 서버 안에서만 열린다(밖에서는 ssh -L)
ADMIN_BIND=127.0.0.1
RABBITMQ_ADMIN_PORT=9971
OPENFIRE_ADMIN_PORT=9972

# VTN, Openfire DB 데이터 디렉토리. 재기동해도 남는다. bin/run.sh reset-db 가 비운다
PGDATA_DIR=./data/postgres

# bin/run.sh backup 이 DB 덤프를 남기는 곳. 실행마다 시각 이름의 하위 디렉토리가 생긴다
BACKUP_DIR=./backup

# VTN 로그(oadr-vtn20b.log)
LOG_DIR=./logs/vtn20b

# VTN 컨테이너 시간대(로그 시각)
TZ=Asia/Seoul

# VTN 이 응답(oadrCreatedPartyRegistration 등)에 싣는 vtnID. VEN 이 vtnID 를 확인하면 VEN 쪽 값과 같아야 한다.
# VTN 관리 화면 VTN 설정 > 설정값의 VTN ID 에도 이 값이 보인다. 바꾸면 bin/run.sh restart
VTN_ID=AVOB_OPEN_ADR

# VEN 이 리포트를 등록하면(oadrRegisterReport) 그 응답에 명세마다 리포트 요청을 실어 준다(주기는 VEN 이 알린 oadrMaxPeriod).
# oadrPoll 을 하지 않고 이 응답의 요청으로만 리포트(oadrUpdateReport)를 보내는 VEN 은 켜 둬야 한다. 끄면 VTN 원래 동작(화면에서 구독)
REPORT_REQUEST_ON_REGISTER=true
