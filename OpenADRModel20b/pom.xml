<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>OpenADRModel20b</artifactId>
	<name>OpenADRModel20b</name>
	<description>Oadr2.0b model framework</description>
	<parent>
		<groupId>com.avob.openadr</groupId>
		<artifactId>OpenADR</artifactId>
		<version>0.1.0-SNAPSHOT</version>
	</parent>
	<dependencies>
		<dependency>
			<groupId>com.avob.openadr</groupId>
			<artifactId>OpenADRSecurity</artifactId>
		</dependency>

		<!-- javax.activation 1.1.1 은 뺐다. JAXB 4 는 jakarta.activation 을 쓰고
		     jakarta.xml.bind-api 가 그걸 끌고 온다. Model20a 도 원래 없이 돌았다 -->
		<dependency>
			<groupId>jakarta.xml.bind</groupId>
			<artifactId>jakarta.xml.bind-api</artifactId>
		</dependency>
		<!-- 런타임 구현은 jaxb-runtime 하나만 둔다. 예전에는 com.sun.xml.bind 의 jaxb-impl, jaxb-core, jaxb-xjc 도
		     compile 로 걸려 있었는데, jaxb-impl 은 jaxb-runtime 과 같은 클래스(com.sun.xml.bind.v2)를 한 벌 더 들고 오고
		     jaxb-xjc 는 코드 생성 도구라 런타임에 필요 없다. 코드에서 쓰는 곳도 없다(Model20a 는 원래 이렇게 돌았다) -->
		<dependency>
			<groupId>org.glassfish.jaxb</groupId>
			<artifactId>jaxb-runtime</artifactId>
		</dependency>

	</dependencies>
	<build>
		<resources>
			<resource>
				<directory>${project.build.directory}/generated-sources/oadr20b</directory>
			</resource>
			<resource>
				<directory>${project.build.directory}/maven-shared-archive-resources/oadr20b_schema/*</directory>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<resource>
				<directory>src/main/java</directory>
			</resource>
		</resources>

		<plugins>
			<!-- XJC 는 org.jvnet.jaxb:jaxb-maven-plugin 4.x 로 돌린다(Model20a 주석 참고).
			     -Xnamespace-prefix 는 jaxb-plugins, -Xannotate 는 jaxb-plugin-annotate 에 들어 있다.
			     바인딩 파일의 네임스페이스는 새 이름(urn:jaxb.jvnet.org:plugin:namespace-prefix,
			     urn:jaxb.jvnet.org:annox)으로 바꿨다.
			     -Xfixed-value 는 jaxb-tools 에 대응 플러그인이 없어서 com.github.fbdo:jaxb2-fixed-value 1.2(최신)를 계속 쓴다.
			     XJC 플러그인 API(com.sun.tools.xjc.Plugin)는 JAXB 4 에서도 같아서 그대로 돈다 -->
			<plugin>
				<groupId>org.jvnet.jaxb</groupId>
				<artifactId>jaxb-maven-plugin</artifactId>
				<version>${jaxb-tools.version}</version>
				<executions>
					<execution>
						<id>generate</id>
						<goals>
							<goal>generate</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<bindingDirectory>xsd/oadr20b_binding</bindingDirectory>
					<bindingIncludes>
						<include>**/*.xjb</include>
					</bindingIncludes>
					<schemaDirectory>xsd/oadr20b_schema</schemaDirectory>
					<schemaIncludes>
						<include>**/*.xsd</include>
					</schemaIncludes>
					<generateDirectory>${project.build.directory}/generated-sources/oadr20b</generateDirectory>

					<args>
						<arg>-extension</arg>
						<arg>-Xnamespace-prefix</arg>
						<arg>-Xfixed-value</arg>
						<arg>-Xannotate</arg>
					</args>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>org.jvnet.jaxb</groupId>
						<artifactId>jaxb-plugins</artifactId>
						<version>${jaxb-tools.version}</version>
					</dependency>
					<dependency>
						<groupId>org.jvnet.jaxb</groupId>
						<artifactId>jaxb-plugin-annotate</artifactId>
						<version>${jaxb-tools.version}</version>
					</dependency>
					<dependency>
						<groupId>com.github.fbdo</groupId>
						<artifactId>jaxb2-fixed-value</artifactId>
						<version>1.2</version>
					</dependency>
					<dependency>
						<groupId>org.glassfish.jaxb</groupId>
						<artifactId>jaxb-xjc</artifactId>
						<version>${glassfish-jaxb.version}</version>
					</dependency>
					<dependency>
						<groupId>org.glassfish.jaxb</groupId>
						<artifactId>jaxb-runtime</artifactId>
						<version>${glassfish-jaxb.version}</version>
					</dependency>
				</dependencies>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco-plugin.version}</version>
				<configuration>
					<destFile>${basedir}/target/coverage-reports/jacoco-unit.exec</destFile>
					<dataFile>${basedir}/target/coverage-reports/jacoco-unit.exec</dataFile>
					<excludes>
						<exclude>com.avob.openadr.model.*.ei.*</exclude>
						<exclude>com.avob.openadr.model.*.emix.*</exclude>
						<exclude>com.avob.openadr.model.*.oadr.*</exclude>
						<exclude>com.avob.openadr.model.*.pyld.*</exclude>
						<exclude>com.avob.openadr.model.*.strm.*</exclude>
						<exclude>com.avob.openadr.model.*.xcal.*</exclude>
						<exclude>com.avob.openadr.model.*.atom.*</exclude>
						<exclude>com.avob.openadr.model.*.gml.*</exclude>
						<exclude>com.avob.openadr.model.*.greenbutton.*</exclude>
						<exclude>com.avob.openadr.model.*.iso.*</exclude>
						<exclude>com.avob.openadr.model.*.power.*</exclude>
						<exclude>com.avob.openadr.model.*.siscale.*</exclude>
						<exclude>com.avob.openadr.model.*.xmldsig.*</exclude>
						<exclude>com.avob.openadr.model.*.xmldsig11.*</exclude>
						<exclude>com.avob.openadr.model.*.xmldsig.properties.*</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>jacoco-initialize</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-site</id>
						<phase>site</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
