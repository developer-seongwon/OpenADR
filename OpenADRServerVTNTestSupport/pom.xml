<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>OpenADRServerVTNTestSupport</artifactId>
	<name>OpenADRServerVTNTestSupport</name>
	<description>VTN 테스트가 공유하는 것들. 지금은 테스트용 DB 컨테이너 하나뿐이다.</description>
	<parent>
		<groupId>com.avob.openadr</groupId>
		<artifactId>OpenADR</artifactId>
		<version>0.1.0-SNAPSHOT</version>
	</parent>

	<!--
		VTN20a 와 VTN20b 가 같은 DB 컨테이너를 재사용해야 하는데, 그 홀더 클래스가
		VTNCommon 의 src/test 에 있었다. 그걸 넘기려고 test-jar 를 만들면서
		includes 로 그 클래스 하나만 골라 냈는데, 그 필터는 package 단계에서만 걸린다.
		mvn test 만 돌리면 메이븐이 test-jar 의존을 리액터의 target/test-classes
		디렉토리로 풀기 때문에 필터가 무시되고 VTNCommon 의 테스트용 클래스가 전부
		딸려 간다. 그중 HttpSecurityConfig 가 VTN20a 의 같은 이름 클래스와 부딪혀서
		ConflictingBeanDefinitionException 으로 죽었다.

		그래서 공유할 것만 별도 모듈의 src/main 에 둔다. test-jar 가 아예 없으니
		필터에 기댈 일도 없고, mvn test 든 mvn install 이든 똑같이 동작한다.
		testcontainers 는 이 모듈에서만 compile 스코프이고, 쓰는 쪽은
		이 모듈 자체를 test 스코프로 받으므로 운영 산출물에는 들어가지 않는다.
	-->
	<dependencies>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
		</dependency>
	</dependencies>
</project>
