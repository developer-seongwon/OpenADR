<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>OpenADRServerVTN20b</artifactId>
	<name>OpenADRServerVTN20b</name>
	<description>VTN2.0b application</description>
	<parent>
		<groupId>com.avob.openadr</groupId>
		<artifactId>OpenADR</artifactId>
		<version>0.1.0-SNAPSHOT</version>
	</parent>
	<properties>
		<swagger.output.dir>${project.build.directory}/swagger</swagger.output.dir>
		<swagger.input>${swagger.output.dir}/swagger.json</swagger.input>
	</properties>
	<dependencies>
		<dependency>
			<groupId>com.avob.openadr</groupId>
			<artifactId>OpenADRHTTPClient20b</artifactId>
		</dependency>
		<dependency>
			<groupId>com.avob.openadr</groupId>
			<artifactId>OpenADRXMPPClient</artifactId>
		</dependency>
		<dependency>
			<groupId>com.avob.openadr</groupId>
			<artifactId>OpenADRServerVTNCommon</artifactId>
		</dependency>
		<!-- VTN20a 의존을 걷어냈다.
		     20b 코드는 oadr20a 패키지를 한 줄도 쓰지 않고, 컴포넌트 스캔 대상도
		     common.vtn 과 oadr20b.vtn 뿐이다. 게다가 VTN20a 의 산출물은
		     spring-boot-maven-plugin 이 다시 묶은 실행 jar 라 클래스가
		     BOOT-INF/classes 안에 있어서 라이브러리로 쓸 수도 없다.
		     그 61MB 짜리 jar 가 VTN20b 실행 jar 안에 통째로 들어가서
		     산출물이 138MB 였다. -->
		<!-- springfox 는 Boot 3 에서 기동조차 못 해 springdoc 으로 교체했다.
		     UI 까지 한 아티팩트에 들어 있어서 두 개가 하나로 줄었다 -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
		</dependency>

		<!-- tests dependencies -->
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-logging</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-logging</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- 테스트 DB 는 VTNCommon 과 같은 도커 PostgreSQL 컨테이너를 재사용한다 -->
		<!-- 테스트용 DB 컨테이너 홀더.
		     예전에는 VTNCommon 의 test-jar 로 받았는데, mvn test 단계에서는
		     메이븐이 그 의존을 리액터의 target/test-classes 디렉토리로 풀기 때문에
		     test-jar 의 includes 필터가 무시되고 VTNCommon 의 테스트 클래스가
		     전부 딸려 왔다. 그중 HttpSecurityConfig 가 여기 같은 이름 클래스와
		     부딪혀서 ConflictingBeanDefinitionException 으로 죽었다.
		     공유할 것만 따로 모듈로 뺐다 -->
		<dependency>
			<groupId>com.avob.openadr</groupId>
			<artifactId>OpenADRServerVTNTestSupport</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- 테스트는 브로커 프로파일과 무관하게 항상 내장 activemq 로 돈다.
		     VtnConfigEmbeddedBroker 가 @Profile({"test","standalone"}) 이라
		     test 프로파일에서 무조건 로드되기 때문이다.
		     VTNCommon 은 이걸 provided 로 들고 있는데 provided 는 전이되지 않고,
		     standalone 프로파일의 compile 스코프는 -P external 이면 사라진다.
		     그래서 external 로 빌드하면 여기 테스트가 BrokerPlugin 을 못 찾고 죽었다.
		     운영 산출물에는 test 스코프라 들어가지 않는다 -->
		<dependency>
			<groupId>org.apache.activemq</groupId>
			<artifactId>activemq-broker</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<resources>
			<resource>
				<directory>${project.build.directory}/maven-shared-archive-resources/oadr20b_schema/*</directory>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<resource>
				<directory>src/main/java</directory>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<!-- 도커 이미지가 loader.path 로 외부 lib 디렉토리의 jar 를 얹기 때문에
				     PropertiesLauncher 로 띄워야 한다. Boot 3 에서 그걸 고르는 방법이
				     layout ZIP 이다.
				     예전에는 mainClass 에 런처를, startClass 에 앱 클래스를 적었는데
				     startClass 는 Boot 3 의 플러그인에 없는 파라미터라
				     "Parameter 'startClass' is unknown" 경고만 내고 무시됐다.
				     그 결과 매니페스트의 Start-Class 가 앱이 아니라 PropertiesLauncher 로
				     잡혀서, loader.properties 의 loader.main 이 없으면 뜨지 못하는 상태였다.

				     executable 도 빠졌다. jar 앞에 기동 스크립트를 붙여 주는 기능인데
				     Boot 4 에서 없어졌다. 도커가 jar 를 직접 실행하고 있어서
				     "Permission denied" 로 죽었고, 지금은 java -jar 로 띄운다 -->
				<configuration>
					<layout>ZIP</layout>
					<mainClass>com.avob.openadr.server.oadr20b.vtn.VTN20bApplication</mainClass>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco-plugin.version}</version>
				<configuration>
					<destFile>${basedir}/target/coverage-reports/jacoco-unit.exec</destFile>
					<dataFile>${basedir}/target/coverage-reports/jacoco-unit.exec</dataFile>
					<excludes>
						<exclude>**/EmbeddedSqlDatabaseInit.*</exclude>
						<exclude>**/SwaggerConfig.*</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>jacoco-initialize</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-site</id>
						<phase>site</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<id>frontend</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>com.github.eirslett</groupId>
						<artifactId>frontend-maven-plugin</artifactId>
						<version>1.8.0</version>
						<configuration>
							<workingDirectory>frontend</workingDirectory>
							<installDirectory>target</installDirectory>

						</configuration>
						<executions>
							<execution>
								<id>install node and npm</id>
								<goals>
									<goal>install-node-and-npm</goal>
								</goals>
								<configuration>
									<!-- node 12 는 darwin-arm64 빌드가 없어 애플 실리콘에서 내려받지 못한다.
									     한편 react-scripts 3.2.0 은 OpenSSL 3 을 쓰는 node 17 이상에서
									     digital envelope routines 오류로 깨진다.
									     둘을 모두 만족하는 게 node 16 이다 -->
									<nodeVersion>v16.20.2</nodeVersion>
									<npmVersion>8.19.4</npmVersion>
								</configuration>
							</execution>
							<execution>
								<id>npm install</id>
								<goals>
									<goal>npm</goal>
								</goals>
								<configuration>
									<arguments>install</arguments>
								</configuration>
							</execution>
							<execution>
								<id>npm run build</id>
								<goals>
									<goal>npm</goal>
								</goals>
								<configuration>
									<arguments>run build</arguments>
									<environmentVariables>
										<PUBLIC_URL>/testvtn/</PUBLIC_URL>
										<REACT_APP_BASENAME>/testvtn/</REACT_APP_BASENAME>
									</environmentVariables>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<artifactId>maven-antrun-plugin</artifactId>
						<executions>
							<execution>
								<phase>generate-resources</phase>
								<configuration>
									<target>
										<copy
											todir="${project.basedir}/src/main/resources/public">
											<fileset dir="${project.basedir}/frontend/build" />
										</copy>
									</target>
								</configuration>
								<goals>
									<goal>run</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>standalone</id>
			<activation>
				
				<activeByDefault>true</activeByDefault>
			</activation>
			<dependencies>
				<dependency>
					<groupId>org.apache.activemq</groupId>
					<artifactId>activemq-broker</artifactId>
				</dependency>
				<!-- 임베디드 H2 를 걷어내고 운영과 같은 PostgreSQL 을 쓴다.
				     MySQL 드라이버도 같이 걸려 있었는데 쓰는 설정이 하나도 없어서 걷어냈다 -->
				<dependency>
					<groupId>org.postgresql</groupId>
					<artifactId>postgresql</artifactId>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>external</id>
			<dependencies>
				<dependency>
					<groupId>com.rabbitmq.jms</groupId>
					<artifactId>rabbitmq-jms</artifactId>
				</dependency>
			</dependencies>
		</profile>
	</profiles>
</project>