<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.avob.openadr</groupId>
	<artifactId>OpenADR</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<name>OpenADR</name>
	<description>client, server 를 한 번에 빌드하는 집계 pom</description>
	<packaging>pom</packaging>

	<!--
	  빌드 편의용 집계 pom 이다. 설정을 물려주지 않는다(client, server 의 부모가 아니다).
	  client/ 와 server/ 는 각자 부모 pom 을 갖고 따로 빌드되며, 나중에 저장소를 나누면 이 파일은 없어진다.

	  여기서 빌드하면 한 리액터 안에서 client 를 먼저 빌드하고 server 가 그 결과를 바로 쓴다.
	  server 는 client 를 좌표(com.avob.openadr:OpenADR*:${openadr-client.version})로 참조하므로
	  server/pom.xml 의 openadr-client.version 이 client 버전과 같아야 리액터 안에서 이어진다.
	-->
	<modules>
		<module>client</module>
		<module>server</module>
	</modules>

</project>
