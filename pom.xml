<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.avob.openadr</groupId>
	<artifactId>OpenADR</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<name>OpenADR</name>
	<description>OpenADR VEN/VTN implementation</description>
	<packaging>pom</packaging>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath></relativePath>
	</parent>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>25</java.version>
		<!-- surefire argLine 의 @{argLine} 기본값. jacoco 를 쓰는 모듈에서는 prepare-agent 가 덮어쓴다 -->
		<argLine></argLine>
		<project.version>0.1.0-SNAPSHOT</project.version>

		<!-- Spring Boot 3 로 올리면서 손댄 버전들 -->
		<!-- activemq 6.x 부터 jakarta.jms 를 쓴다. 5.x 는 javax.jms 라 Boot 3 에서 못 쓴다.
		     Boot 4.1 BOM 은 6.2.9 를 관리한다. Boot 의 프로퍼티 이름(activemq.version)으로 최신 6.3 까지 올린다.
		     예전에는 따로 amq.version 을 두어서 Boot 관리 값과 우리 값이 따로 놀았다 -->
		<activemq.version>6.3.2</activemq.version>
		<!-- smack 4.4 에서 smack-java7 아티팩트가 없어져 XMPPClient 가 깨진다. 4.3.4 유지 -->
		<smack.version>4.3.4</smack.version>
		<!-- jacoco 는 JDK 메이저마다 새 버전이 필요하다. 0.8.12 는 Java 22 까지라서
		     Java 25 클래스(major 69)를 만나면 "Unsupported class file major version 69" 를
		     테스트마다 찍어 댄다. 테스트는 통과하지만 커버리지가 비므로 0.8.14 로 올린다 -->
		<jacoco-plugin.version>0.8.14</jacoco-plugin.version>
		<!-- PostgreSQL 드라이버와 testcontainers 는 고정하지 않고 Boot BOM 값(postgresql.version,
		     testcontainers.version)을 쓴다. 예전 고정값 42.6.0, 2.0.2 가 Boot 의 최신값(42.7.13, 2.0.5)을
		     끌어내리고 있었다. 테스트는 H2 대신 도커의 PostgreSQL 을 쓴다(운영과 같은 DB 라야 DDL 이 안 어긋난다).
		     testcontainers 는 2.x 라야 도커 엔진 29(API 1.44 이상)에 붙는다 -->
		<!-- rabbitmq-jms 3.x 가 jakarta.jms 대응 버전이다. Boot 가 관리하지 않아서 직접 고정한다 -->
		<rabbitmq-jms.version>3.9.0</rabbitmq-jms.version>
		<!-- springfox 는 Boot 3 에서 동작하지 않아 springdoc 으로 교체한다.
		     springdoc 버전은 스프링 버전을 따라간다. 2.2 는 Spring 6.0, 2.8 은 6.2,
		     3.x 가 Boot 4(Spring 7) 대응이다. 어긋나면 빌드는 통과하고
		     런타임에 /v3/api-docs 가 500 으로 터진다 -->
		<springdoc.version>3.1.1</springdoc.version>
		<!-- commons-compress, guava 는 Boot 가 관리하지 않아서 직접 고정한다 -->
		<commons-compress.version>1.28.0</commons-compress.version>
		<!-- commons-lang3 는 고정하지 않는다.
		     Boot 3.1.5 때는 BOM 이 3.12.0 이라 commons-compress 가 요구하는
		     SystemProperties 가 없어서 3.14.0 으로 올려 두었다.
		     Boot 4 의 BOM 은 3.20.0 이라 그 고정이 오히려 버전을 끌어내렸고,
		     springdoc 3 이 쓰는 org.apache.commons.lang3.Strings(3.18 에서 추가)가
		     없어서 /v3/api-docs 가 NoClassDefFoundError 로 500 이 났다 -->
		<guava.version>33.7.1-jre</guava.version>
		<!-- Boot 4.1 BOM 은 JUnit 6.0.3 을 관리한다. 최신 6.1 로 올린다.
		     junit-jupiter.version 은 Boot BOM 이 쓰는 프로퍼티라 여기서 덮으면 junit-bom 전체가 따라온다 -->
		<junit-jupiter.version>6.1.3</junit-jupiter.version>
		<!-- Apache httpclient 4 와 commons-logging 은 고정하지 않는다.
		     OpenADRHTTPClient 가 자바 표준 java.net.http.HttpClient 로 바뀌어서 httpclient 를 쓰는 곳이 없다.
		     commons-logging 1.2 고정은 httpclient 때문에 걸어 둔 것이었는데, 그게 스프링 앱까지
		     1.2 로 끌어내리고 있었다(Spring 7 은 1.3.5 이상을 요구한다).
		     Boot 4.1 BOM 은 1.3.6 이라 Boot 의 프로퍼티 이름으로 최신 1.4 까지 올린다 -->
		<commons-logging.version>1.4.0</commons-logging.version>
		<!-- JAXB 는 Boot BOM 값(glassfish-jaxb.version, jakarta-xml-bind.version)을 쓴다.
		     예전 jaxb.version 4.0.3 고정은 Boot 의 4.0.9 를 끌어내렸고, jakarta-xml-bind.version 은
		     Boot 와 이름이 같아서 Boot 의 4.0.5 를 4.0.0 으로 덮고 있었다.
		     XJC 플러그인 의존성에는 BOM 이 안 먹어서 같은 프로퍼티를 직접 적는다(Model20a, Model20b) -->
		<activation.version>1.1.1</activation.version>
	</properties>



	<dependencies>
		<!-- 테스트는 전부 JUnit Jupiter 로 옮겼다. JUnit 4 와 vintage 엔진은 걷어냈다.
		     스프링을 안 쓰는 모듈(Model, Security, HTTPClient)도 있어서 starter-test 에 기대지 않고
		     여기서 모든 모듈에 한 번에 넣는다 -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Java 21 부터 JVM 이 런타임에 에이전트를 붙이는 걸 경고하고 (JEP 451),
		     나중에는 막을 예정이다. Mockito 의 inline mock maker 가 그렇게 자기 자신을
		     붙이므로 surefire 가 -javaagent 로 미리 올려 준다.
		     모든 모듈에 넣는 이유는 아래 dependency:properties 가 만드는
		     org.mockito:mockito-core:jar 프로퍼티가 의존성 없는 모듈에서는
		     비어 있어 argLine 이 깨지기 때문이다. 테스트 스코프라 배포 jar 에는 안 들어간다 -->
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>



	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.avob.openadr</groupId>
				<artifactId>OpenADRModel20b</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.avob.openadr</groupId>
				<artifactId>OpenADRHTTPClient</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.avob.openadr</groupId>
				<artifactId>OpenADRSecurity</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.avob.openadr</groupId>
				<artifactId>OpenADRModel20a</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.avob.openadr</groupId>
				<artifactId>OpenADRHTTPClient20a</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.avob.openadr</groupId>
				<artifactId>OpenADRHTTPClient20b</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.avob.openadr</groupId>
				<artifactId>OpenADRXMPPClient</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.avob.openadr</groupId>
				<artifactId>OpenADRServerVTNCommon</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.avob.openadr</groupId>
				<artifactId>OpenADRServerVTNTestSupport</artifactId>
				<version>${project.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>com.avob.openadr</groupId>
				<artifactId>OpenADRServerVTN20a</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.avob.openadr</groupId>
				<artifactId>OpenADRServerVEN20b</artifactId>
				<version>${project.version}</version>
			</dependency>


			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.postgresql</groupId>
				<artifactId>postgresql</artifactId>
				<version>${postgresql.version}</version>
			</dependency>
			<dependency>
				<groupId>com.rabbitmq.jms</groupId>
				<artifactId>rabbitmq-jms</artifactId>
				<version>${rabbitmq-jms.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.activemq</groupId>
				<artifactId>activemq-broker</artifactId>
				<version>${activemq.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.activemq</groupId>
				<artifactId>activemq-client</artifactId>
				<version>${activemq.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
				<version>${springdoc.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-compress</artifactId>
				<version>${commons-compress.version}</version>
			</dependency>
			<dependency>
				<groupId>com.google.guava</groupId>
				<artifactId>guava</artifactId>
				<version>${guava.version}</version>
			</dependency>

			<!-- JAXB. XJC 가 jakarta 애노테이션으로 코드를 생성하게 하려면
			     런타임과 플러그인 양쪽에 4.x 를 고정해야 한다 -->
			<dependency>
				<groupId>jakarta.xml.bind</groupId>
				<artifactId>jakarta.xml.bind-api</artifactId>
				<version>${jakarta-xml-bind.version}</version>
			</dependency>
			<dependency>
				<groupId>com.sun.xml.bind</groupId>
				<artifactId>jaxb-impl</artifactId>
				<version>${glassfish-jaxb.version}</version>
			</dependency>
			<dependency>
				<groupId>com.sun.xml.bind</groupId>
				<artifactId>jaxb-core</artifactId>
				<version>${glassfish-jaxb.version}</version>
			</dependency>
			<dependency>
				<groupId>com.sun.xml.bind</groupId>
				<artifactId>jaxb-xjc</artifactId>
				<version>${glassfish-jaxb.version}</version>
			</dependency>
			<dependency>
				<groupId>org.glassfish.jaxb</groupId>
				<artifactId>jaxb-runtime</artifactId>
				<version>${glassfish-jaxb.version}</version>
			</dependency>
			<dependency>
				<groupId>javax.activation</groupId>
				<artifactId>activation</artifactId>
				<version>${activation.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>



	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<release>${java.version}</release>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-external-dependency</id>
						<phase>none</phase>
						<goals>
							<goal>copy</goal>
						</goals>
					</execution>
					<!-- 의존성마다 groupId:artifactId:type 이름의 프로퍼티에 jar 경로를 넣어 준다.
					     아래 surefire 의 -javaagent 가 mockito-core 경로를 이걸로 받는다 -->
					<execution>
						<id>mockito-agent-path</id>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<artifactItems>
						<artifactItem>
							<groupId>org.postgresql</groupId>
							<artifactId>postgresql</artifactId>
							<version>${postgresql.version}</version>
							<type>jar</type>
							<outputDirectory>${project.build.directory}/</outputDirectory>
						</artifactItem>
					</artifactItems>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- @{argLine} 은 jacoco prepare-agent 가 채우는 값이다.
					     jacoco 를 안 쓰는 모듈은 properties 의 빈 argLine 이 들어간다 -->
					<argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<!-- 전 모듈이 Spring Boot 4 / Java 25 로 이관됐다.
	     빌드 순서는 메이븐이 의존 관계를 보고 알아서 잡는다 -->
	<modules>
		<module>./OpenADRSecurity</module>
		<module>./OpenADRModel20a</module>
		<module>./OpenADRModel20b</module>
		<module>./OpenADRHTTPClient</module>
		<module>./OpenADRHTTPClient20a</module>
		<module>./OpenADRHTTPClient20b</module>
		<module>./OpenADRXMPPClient</module>

		<module>./OpenADRServerVTNCommon</module>
		<module>./OpenADRServerVTNTestSupport</module>
		<module>./OpenADRServerVTN20a</module>

		<module>./OpenADRServerVEN20b</module>
		<module>./OpenADRServerVTN20b</module>
		<module>./DummyVEN20b</module>
		<module>./DummyDRProgram</module>
	</modules>

	<scm>
		<url>https://github.com/avob/OpenADR</url>
		<connection>scm:git:git://github.com/avob/OpenADR</connection>
		<developerConnection>scm:git:git@github.com/avob/OpenADR</developerConnection>
	</scm>
	<developers>
		<developer>
			<email>zanni.bertrand@gmail.com</email>
			<name>Bertrand Zanni</name>
			<url>https://github.com/zanni</url>
			<id>zanni</id>
		</developer>
	</developers>


</project>
