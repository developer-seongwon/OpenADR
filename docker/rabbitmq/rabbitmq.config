[
  {rabbit, [
        {ssl_listeners, [5671]},{ssl_options, [{cacertfile,           "/opt/oadr-vtn20b/cert/oadr.com.crt"},
                           {certfile,             "/opt/oadr-vtn20b/cert/vtn.oadr.com-rsa.crt"},
                           {keyfile,              "/opt/oadr-vtn20b/cert/vtn.oadr.com-rsa.key"},
                           {verify,               verify_peer},
                           {fail_if_no_peer_cert, true}]}
        , {auth_mechanisms, ['PLAIN', 'AMQPLAIN', 'EXTERNAL']}
        %% 이 파일은 지금 이미지에 들어가지 않는다(Dockerfile 이 복사하지 않아 RabbitMQ 기본 설정으로 뜬다).
        %% 나중에 넣을 때를 대비해 인증은 내부 계정만 쓰게 해 둔다.
        %% 예전 설정은 내부 인증에 실패하면 cache -> http 백엔드로 VTN 의 /auth/user 에 물었는데,
        %% 그 컨트롤러(RabbitmqHTTPAuthController)는 아이디/비밀번호를 보지 않고 항상
        %% "allow administrator management" 를 돌려준다. 이 설정을 그대로 쓰면 5672, 15672 에
        %% 아무 계정으로나 관리자로 들어갈 수 있다. VTN, DummyDRProgram 은 모두 RABBITMQ_DEFAULT_USER 계정을 쓴다.
        , {auth_backends, [rabbit_auth_backend_internal]}
        ]
   }
].
