<?xml version="1.0" encoding="UTF-8"?>
<!--
    Openfire 부트스트랩 설정. 도커 이미지가 $OPENFIRE_HOME/conf/openfire.xml 로 넣는다.
    대부분의 설정은 DB 의 ofProperty 에 있다(docker/postgres/init-openfire.sh).

    DB 사용자와 비밀번호는 평문으로 둔다. 예전 파일은 Openfire 4.4 의 기본 키로 암호화한 값이었는데,
    그 값은 conf/security.xml 의 암호화 설정에 묶여 있어서 버전을 올리면 풀리지 않을 수 있다.
    비밀번호 자체는 init-openfire.sh 에 평문으로 있는 개발용 값이다.
-->
<jive>
    <adminConsole>
        <!-- Disable either port by setting the value to -1 -->
        <port>9090</port>
        <securePort>9091</securePort>
    </adminConsole>
    <locale>en</locale>
    <connectionProvider>
        <className>org.jivesoftware.database.DefaultConnectionProvider</className>
    </connectionProvider>
    <database>
        <defaultProvider>
            <driver>org.postgresql.Driver</driver>
            <serverURL>jdbc:postgresql://postgres:5432/oadr-openfire</serverURL>
            <username>oadr-openfire</username>
            <password>supersecure</password>
            <testSQL>select 1</testSQL>
            <testBeforeUse>false</testBeforeUse>
            <testAfterUse>false</testAfterUse>
            <testTimeout>500</testTimeout>
            <timeBetweenEvictionRuns>30000</timeBetweenEvictionRuns>
            <minIdleTime>900000</minIdleTime>
            <maxWaitTime>500</maxWaitTime>
            <minConnections>5</minConnections>
            <maxConnections>25</maxConnections>
            <connectionTimeout>1.0</connectionTimeout>
        </defaultProvider>
    </database>
    <setup>true</setup>
    <fqdn>xmpp.vtn.oadr.com</fqdn>
</jive>
