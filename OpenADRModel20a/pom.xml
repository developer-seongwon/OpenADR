<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>OpenADRModel20a</artifactId>
	<name>OpenADRModel20a</name>
	<description>Oadr2.0a model framework</description>
	<parent>
		<groupId>com.avob.openadr</groupId>
		<artifactId>OpenADR</artifactId>
		<version>0.1.0-SNAPSHOT</version>
	</parent>
	<dependencies>
		<dependency>
			<groupId>jakarta.xml.bind</groupId>
			<artifactId>jakarta.xml.bind-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.glassfish.jaxb</groupId>
			<artifactId>jaxb-runtime</artifactId>
		</dependency>
	</dependencies>
	<build>
		<resources>
			<resource>
				<directory>${project.build.directory}/generated-sources/oadr20a</directory>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<includes>
					<include>**/*.xsd</include>
				</includes>
			</resource>
		</resources>
		<plugins>

			<!-- XJC 는 org.jvnet.jaxb:jaxb-maven-plugin 4.x 로 돌린다.
			     예전 org.jvnet.jaxb2.maven2:maven-jaxb2-plugin 0.14 는 javax 시절 플러그인이라
			     플러그인 클래스패스에 JAXB 4 를 억지로 올려야 jakarta 코드가 나왔다. 4.x 는 처음부터 JAXB 4 용이다.
			     xjc 와 런타임 버전은 Boot 의 glassfish-jaxb.version 으로 맞춘다.
			     -Xnamespace-prefix 는 jaxb-plugins 에 들어 있다. 4.x 는 바인딩 파일의 예전 네임스페이스
			     (http://jaxb2-commons.dev.java.net/namespace-prefix)를 거부해서 bindings.xjb 를
			     새 이름(urn:jaxb.jvnet.org:plugin:namespace-prefix)으로 바꿨다 -->
			<plugin>
				<groupId>org.jvnet.jaxb</groupId>
				<artifactId>jaxb-maven-plugin</artifactId>
				<version>${jaxb-tools.version}</version>
				<executions>
					<execution>
						<id>generate</id>
						<goals>
							<goal>generate</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<bindingDirectory>xsd/oadr20a_binding</bindingDirectory>
					<schemaDirectory>xsd/oadr20a_schema</schemaDirectory>
					<generateDirectory>${project.build.directory}/generated-sources/oadr20a</generateDirectory>

					<args>
						<arg>-extension</arg>
						<arg>-Xnamespace-prefix</arg>
					</args>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>org.jvnet.jaxb</groupId>
						<artifactId>jaxb-plugins</artifactId>
						<version>${jaxb-tools.version}</version>
					</dependency>
					<dependency>
						<groupId>org.glassfish.jaxb</groupId>
						<artifactId>jaxb-xjc</artifactId>
						<version>${glassfish-jaxb.version}</version>
					</dependency>
					<dependency>
						<groupId>org.glassfish.jaxb</groupId>
						<artifactId>jaxb-runtime</artifactId>
						<version>${glassfish-jaxb.version}</version>
					</dependency>
				</dependencies>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco-plugin.version}</version>
				<configuration>
					<destFile>${basedir}/target/coverage-reports/jacoco-unit.exec</destFile>
					<dataFile>${basedir}/target/coverage-reports/jacoco-unit.exec</dataFile>
					<excludes>
						<exclude>com.avob.openadr.model.*.ei.*</exclude>
						<exclude>com.avob.openadr.model.*.emix.*</exclude>
						<exclude>com.avob.openadr.model.*.oadr.*</exclude>
						<exclude>com.avob.openadr.model.*.pyld.*</exclude>
						<exclude>com.avob.openadr.model.*.strm.*</exclude>
						<exclude>com.avob.openadr.model.*.xcal.*</exclude>
						<exclude>com.avob.openadr.model.*.atom.*</exclude>
						<exclude>com.avob.openadr.model.*.gml.*</exclude>
						<exclude>com.avob.openadr.model.*.greenbutton.*</exclude>
						<exclude>com.avob.openadr.model.*.iso.*</exclude>
						<exclude>com.avob.openadr.model.*.power.*</exclude>
						<exclude>com.avob.openadr.model.*.siscale.*</exclude>
						<exclude>com.avob.openadr.model.*.xmldsig.*</exclude>
						<exclude>com.avob.openadr.model.*.xmldsig11.*</exclude>
						<exclude>com.avob.openadr.model.*.xmldsig.properties.*</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>jacoco-initialize</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-site</id>
						<phase>site</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>