<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.avob.openadr</groupId>
	<artifactId>OpenADRClient</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<name>OpenADRClient</name>
	<description>OpenADR 모델, 보안, HTTP/XMPP 클라이언트 라이브러리</description>
	<packaging>pom</packaging>

	<!--
	  클라이언트 라이브러리 그룹의 부모 pom. 이 디렉토리만으로 빌드된다(server 를 참조하지 않는다).
	  나중에 저장소를 나누면 이 디렉토리가 그대로 저장소 루트가 된다.

	    cd client && mvn clean install

	  install 한 jar 를 server 와 kpx-service 가 쓴다. kpx-service 는 OpenADRModel20b, OpenADRSecurity 만 쓴다.

	  Boot 의 starter-parent 를 부모로 두는 건 버전 관리(BOM)와 플러그인 기본값 때문이다.
	  클라이언트 모듈은 스프링 앱이 아니고 일반 jar 로 나간다.
	  공통 설정(자바 버전, 테스트, BOM 정책)은 server/pom.xml 과 같게 유지한다. 한쪽을 고치면 다른 쪽도 본다.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath></relativePath>
	</parent>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>25</java.version>
		<!-- surefire argLine 의 @{argLine} 기본값. jacoco 를 쓰는 모듈에서는 prepare-agent 가 덮어쓴다 -->
		<argLine></argLine>

		<!-- Boot 가 관리하는 라이브러리는 버전을 덮지 않고 Boot BOM 값을 그대로 쓴다.
		     BOM 은 Spring 팀이 서로 맞춰 검증한 조합이고, 덮어 두면 Boot 를 올려도 그 값에 묶여서
		     나중에는 오히려 Boot 보다 낮은 버전을 쓰게 된다. 최신이 필요하면 Boot 를 올린다.
		     새 자바로 갈 때 Boot 의 byte-buddy(Mockito 가 쓴다)가 새 클래스 파일 버전을 아직 모르면,
		     그때만 byte-buddy.version 을 잠깐 덮는다. Boot 가 따라오면 바로 지운다 -->
		<!-- smack 4.3 의 smack-java7 은 4.4 에서 smack-java8, 4.5 에서 smack-java11 로 이름이 바뀌었다.
		     4.4 부터 Message, Presence 를 new 로 만들지 않고 연결의 StanzaFactory 로 만든다 -->
		<smack.version>4.5.0</smack.version>
		<!-- jacoco 는 JDK 메이저마다 새 버전이 필요하다. 0.8.12 는 Java 22 까지라서
		     Java 25 클래스(major 69)를 만나면 "Unsupported class file major version 69" 를
		     테스트마다 찍어 댄다. 테스트는 통과하지만 커버리지가 비므로 올린다.
		     새 JDK 가 나오면 제일 먼저 올려야 하는 플러그인이라 최신(0.8.15)을 유지한다 -->
		<jacoco-plugin.version>0.8.15</jacoco-plugin.version>
		<!-- BouncyCastle 은 Boot 가 관리하지 않는다. bcpkix 와 bcprov, bcutil 은 같은 버전으로 맞춰야 해서
		     셋 다 여기서 고정한다. jdk15on 1.64 에서 jdk18on 으로 옮겼다 -->
		<bouncycastle.version>1.86</bouncycastle.version>
		<!-- StAX 구현체(FasterXML Woodstox). XMPPClient 가 JDK 내장 StAX 대신 쓴다(OpenADRXMPPClient pom 주석 참고).
		     Boot 가 관리하지 않아서 직접 고정한다 -->
		<woodstox.version>7.2.2</woodstox.version>
		<!-- JAXB 는 Boot BOM 값(glassfish-jaxb.version, jakarta-xml-bind.version)을 쓴다.
		     예전 jaxb.version 4.0.3 고정은 Boot 의 4.0.9 를 끌어내렸고, jakarta-xml-bind.version 은
		     Boot 와 이름이 같아서 Boot 의 4.0.5 를 4.0.0 으로 덮고 있었다.
		     XJC 플러그인 의존성에는 BOM 이 안 먹어서 같은 프로퍼티를 직접 적는다(Model20a, Model20b) -->
		<!-- XJC 메이븐 플러그인과 XJC 플러그인들(org.jvnet.jaxb). 예전 org.jvnet.jaxb2.maven2 0.14 의 후속이다 -->
		<jaxb-tools.version>4.0.16</jaxb-tools.version>
		<!-- Apache httpclient 4 와 commons-logging 은 고정하지 않는다.
		     OpenADRHTTPClient 가 자바 표준 java.net.http.HttpClient 로 바뀌어서 httpclient 를 쓰는 곳이 없다 -->
	</properties>

	<dependencies>
		<!-- 테스트는 전부 JUnit Jupiter 다. 스프링을 안 쓰는 모듈(Model, Security, HTTPClient)이라
		     starter-test 에 기대지 않고 여기서 모든 모듈에 한 번에 넣는다 -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Java 21 부터 JVM 이 런타임에 에이전트를 붙이는 걸 경고하고 (JEP 451),
		     나중에는 막을 예정이다. Mockito 의 inline mock maker 가 그렇게 자기 자신을
		     붙이므로 surefire 가 -javaagent 로 미리 올려 준다.
		     모든 모듈에 넣는 이유는 아래 dependency:properties 가 만드는
		     org.mockito:mockito-core:jar 프로퍼티가 의존성 없는 모듈에서는
		     비어 있어 argLine 이 깨지기 때문이다. 테스트 스코프라 배포 jar 에는 안 들어간다 -->
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.avob.openadr</groupId>
				<artifactId>OpenADRSecurity</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.avob.openadr</groupId>
				<artifactId>OpenADRModel20a</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.avob.openadr</groupId>
				<artifactId>OpenADRModel20b</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.avob.openadr</groupId>
				<artifactId>OpenADRHTTPClient</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.avob.openadr</groupId>
				<artifactId>OpenADRHTTPClient20a</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.avob.openadr</groupId>
				<artifactId>OpenADRHTTPClient20b</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.avob.openadr</groupId>
				<artifactId>OpenADRXMPPClient</artifactId>
				<version>${project.version}</version>
			</dependency>

			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcpkix-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcprov-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcutil-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
			<dependency>
				<groupId>com.fasterxml.woodstox</groupId>
				<artifactId>woodstox-core</artifactId>
				<version>${woodstox.version}</version>
			</dependency>

			<!-- JAXB. 런타임은 jakarta.xml.bind-api 와 org.glassfish.jaxb:jaxb-runtime 만 쓴다 -->
			<dependency>
				<groupId>jakarta.xml.bind</groupId>
				<artifactId>jakarta.xml.bind-api</artifactId>
				<version>${jakarta-xml-bind.version}</version>
			</dependency>
			<dependency>
				<groupId>org.glassfish.jaxb</groupId>
				<artifactId>jaxb-runtime</artifactId>
				<version>${glassfish-jaxb.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<release>${java.version}</release>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<!-- 의존성마다 groupId:artifactId:type 이름의 프로퍼티에 jar 경로를 넣어 준다.
					     아래 surefire 의 -javaagent 가 mockito-core 경로를 이걸로 받는다 -->
					<execution>
						<id>mockito-agent-path</id>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- @{argLine} 은 jacoco prepare-agent 가 채우는 값이다.
					     jacoco 를 안 쓰는 모듈은 properties 의 빈 argLine 이 들어간다 -->
					<argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<!-- 빌드 순서는 메이븐이 의존 관계를 보고 알아서 잡는다 -->
	<modules>
		<module>./OpenADRSecurity</module>
		<module>./OpenADRModel20a</module>
		<module>./OpenADRModel20b</module>
		<module>./OpenADRHTTPClient</module>
		<module>./OpenADRHTTPClient20a</module>
		<module>./OpenADRHTTPClient20b</module>
		<module>./OpenADRXMPPClient</module>
	</modules>

	<scm>
		<url>https://github.com/avob/OpenADR</url>
		<connection>scm:git:git://github.com/avob/OpenADR</connection>
		<developerConnection>scm:git:git@github.com/avob/OpenADR</developerConnection>
	</scm>
	<developers>
		<developer>
			<email>zanni.bertrand@gmail.com</email>
			<name>Bertrand Zanni</name>
			<url>https://github.com/zanni</url>
			<id>zanni</id>
		</developer>
	</developers>

</project>
