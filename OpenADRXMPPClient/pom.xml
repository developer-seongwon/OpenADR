<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>OpenADRXMPPClient</artifactId>
	<name>OpenADRXMPPClient</name>
	<description>Oadr2.0b XMPP client framework</description>
	<parent>
		<groupId>com.avob.openadr</groupId>
		<artifactId>OpenADR</artifactId>
		<version>0.1.0-SNAPSHOT</version>
	</parent>
	<dependencies>
		<dependency>
			<groupId>com.avob.openadr</groupId>
			<artifactId>OpenADRSecurity</artifactId>
		</dependency>
		<dependency>
			<groupId>com.avob.openadr</groupId>
			<artifactId>OpenADRModel20b</artifactId>
		</dependency>
		<!-- smack 4.5.0 의 pom 들은 junit-jupiter-api 5.12, mockito-core 를 compile 스코프로 적어 두었다(배포 실수).
		     루트 pom 이 junit-jupiter, mockito-core 를 모든 모듈에 test 스코프로 선언하고 있어서
		     메이븐이 test 스코프로 정리하고 배포 jar 에는 안 들어간다(dependency:tree 로 확인).
		     루트의 그 선언을 빼면 여기서 exclusion 을 걸어야 한다 -->
		<dependency>
			<groupId>org.igniterealtime.smack</groupId>
			<artifactId>smack-tcp</artifactId>
			<version>${smack.version}</version>
		</dependency>
		<dependency>
			<groupId>org.igniterealtime.smack</groupId>
			<artifactId>smack-im</artifactId>
			<version>${smack.version}</version>
		</dependency>
		<dependency>
			<groupId>org.igniterealtime.smack</groupId>
			<artifactId>smack-extensions</artifactId>
			<version>${smack.version}</version>
		</dependency>
		<dependency>
			<groupId>org.igniterealtime.smack</groupId>
			<artifactId>smack-resolver-dnsjava</artifactId>
			<version>${smack.version}</version>
		</dependency>
		<!-- smack-java11 은 XML 파서로 StAX(smack-xmlparser-stax)를 쓴다. smack 은 XMLInputFactory.newInstance() 로
		     구현체를 고르는데, 클래스패스에 Woodstox 가 있으면 ServiceLoader 로 Woodstox 가 잡힌다.

		     JDK 내장 StAX 를 쓰면 안 되는 이유: 자바 24 부터 JDK 기본 XML 제한(conf/jaxp.properties)이 걸리고,
		     JDK StAX 는 &lt; 같은 기본 엔티티 참조를 문서 크기로 누적해서 센다. XMPP 스트림은 연결 내내
		     하나의 XML 문서라 연결 하나로 이스케이프된 본문 약 1MB 를 주고받으면 그 뒤 스탠자가 전부
		     "JAXP00010003 ... [xml] ... 100,000" 으로 버려진다. Woodstox 는 이 누적 제한이 없다
		     (SmackXmlParserTest 가 JDK 실패 재현과 Woodstox 통과를 같이 확인한다).

		     XPP3(smack-xmlparser-xpp3)는 오래전에 멈춘 라이브러리라 쓰지 않는다.
		     Woodstox 는 FasterXML(Jackson 쪽)이 관리하는 StAX 구현체로 WildFly 의 기본 StAX 이기도 하다.
		     이 모듈을 쓰는 VTN, VEN 은 JVM 전체의 StAX 구현체가 Woodstox 로 바뀐다 -->
		<dependency>
			<groupId>org.igniterealtime.smack</groupId>
			<artifactId>smack-java11</artifactId>
			<version>${smack.version}</version>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.woodstox</groupId>
			<artifactId>woodstox-core</artifactId>
		</dependency>

	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco-plugin.version}</version>
				<configuration>
					<destFile>${basedir}/target/coverage-reports/jacoco-unit.exec</destFile>
					<dataFile>${basedir}/target/coverage-reports/jacoco-unit.exec</dataFile>
				</configuration>
				<executions>
					<execution>
						<id>jacoco-initialize</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-site</id>
						<phase>site</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>